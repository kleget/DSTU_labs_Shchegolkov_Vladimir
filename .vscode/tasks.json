{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run active C++ lab (MSVC)",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\run-cpp.cmd",
            "args": [
                "${file}",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "${env:ComSpec}",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "process",
            "label": "C/C++: cl.exe build active file",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/build-cpp.ps1",
                "-Source",
                "${file}",
                "-Workspace",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the active .cpp with MSVC x64 and debug symbols in out/cpp."
        },
        {
            "label": "C++: build all .cpp in active folder (MSVC)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/build-cpp.ps1",
                "-Source",
                "${file}",
                "-Workspace",
                "${workspaceFolder}",
                "-AllInDirectory"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
